APP_NAME="KFS Runners API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kfs_runners
DB_USERNAME=root
DB_PASSWORD=

KFS_ADMIN_NAME="KFS Administrator"
KFS_ADMIN_EMAIL=admin@example.com
KFS_ADMIN_PASSWORD="change-this-to-a-long-random-password"

# Do not configure EasyCash until its official API/callback spec and keys are available.
EASYCASH_BASE_URL=
EASYCASH_MERCHANT_ID=
EASYCASH_SECRET=
